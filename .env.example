# 이 파일을 `.env` 로 복사해 실제 주소를 채운다. `.env` 는 커밋하지 않는다.
# `config.load_env_file` 이 현재 디렉터리에서 위로 올라가며 `.env` 를 찾아
# **아직 없는** 환경변수만 채운다(이미 export 한 값이 우선).

# ── 모델 호출 (필수) ────────────────────────────────────────────────
# PaddleX PP-StructureV3 Basic Serving. 실행 옵션은 서버의 파이프라인 YAML 이
# 정한다 — 이 파이프라인은 요청 본문에 {"fileType": 1} 만 보낸다.
PADDLEX_URL=http://127.0.0.1:18081/layout-parsing
PADDLEX_TIMEOUT=300

# OpenAI 호환 VLM(chat/completions). strict json_schema 를 지원해야 한다.
GEMMA_URL=http://127.0.0.1:4000/v1/chat/completions
GEMMA_MODEL=YOUR_MODEL_NAME
GEMMA_TIMEOUT_S=120

# ── 입력 분할 (선택) ────────────────────────────────────────────────
# 긴 변÷짧은 변이 이 값을 넘으면 글자 밀도 기준으로 나눠 보낸다. 레이아웃 모델이
# 입력을 800x800 정사각으로 눌러 넣기 때문에, 픽셀 수가 아니라 **종횡비**가
# 실효 해상도를 정한다(실측 2026-09-16).
PARSER_V2_ASPECT_LIMIT=2.0
PARSER_V2_TILE_SPAN=1600
PARSER_V2_ENCODE=jpeg

# ── HWP 로컬 렌더 (선택) ───────────────────────────────────────────
# 기본 auto: document-processor HTML/Chromium → LibreOffice. 한컴 COM은 사용하지 않는다.
# HWP_RENDER_BACKEND=auto
# HWP_CHROMIUM=C:/Program Files/Google/Chrome/Application/chrome.exe
# HWP_SOFFICE=C:/Program Files/LibreOffice/program/soffice.exe

# ── 산출물 위치 (선택) ──────────────────────────────────────────────
# NH_OUTPUT_ROOT=./outputs
# NH_MEDIA_DIR=./.media

# ── VLM 응답 캐시 (선택) ────────────────────────────────────────────
# r = 기존 응답 재사용 + 새 응답 기록, p = 캐시만 재생(없으면 실패)
# VLM_CACHE=p
# VLM_CACHE_DIR=.vlm_cache
